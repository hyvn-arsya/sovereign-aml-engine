# ===== Sovereign AML Engine - Environment Variables Template =====
# Copy this file to `.env` and fill in your real keys. Never commit `.env`.

# --- Required: LLM provider keys ---
# Agent 2 - Document extraction (LlamaParse + Gemini)
LLAMACLOUD_API_KEY=
GOOGLE_API_KEY=

# Agent 4 - Compliance memo drafting (Anthropic)
ANTHROPIC_API_KEY=

# --- Optional: additional providers / integrations ---
OPENAI_API_KEY=
FMP_API_KEY=
PEP_API_KEY=
GOVERNMENT_API_KEY=

# --- Model selection ---
EXTRACTION_MODEL=gemini-1.5-pro

# --- Deployment / AWS (managed by CDK at runtime) ---
ENV=development
S3_BUCKET=sovereign-engine-raw-documents
AUDIT_BUCKET=

# --- Database (optional; defaults to local SQLite if DB_HOST is empty) ---
DB_HOST=
DB_USER=postgres
DB_PASS=
DB_NAME=sovereign

# --- API authentication (tenant-scoped API keys) ---
# Every /analyze/* and /jobs/* request must send an `X-Api-Key` header.
# Keys are stored only as a salted SHA-256 hash; never store or rotate the salt.
# Format: comma-separated <tenant-name>:<api-key> pairs; the tenant prefix also
# scopes uploaded S3 keys (`acme-corp/uploads/...`). Seeded only at startup.
# SECURITY: outside development (prod runtime), startup FAILS if this is
# missing or still the checked-in dev default.
API_KEY_SALT=change-me-to-a-random-value
SEED_API_KEYS=acme-corp:change-me

# --- Screening source mode (fail-closed!) ---
# demo       = use bundled mock DFAT/PEP seed data (default, for development)
# production = refuse to start screening unless real data sources are configured
#              (DFAT_SOURCE_URL for the consolidated list, PEP_API_KEY for PEP)
SCREENING_MODE=demo
DFAT_SOURCE_URL=
